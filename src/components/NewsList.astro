---
import { inlineMd, url, type getNews } from '../lib/site';

interface Props {
  items: Awaited<ReturnType<typeof getNews>>;
  hideProjectLink?: boolean;
}
const { items, hideProjectLink = false } = Astro.props;
---

<ul class="news">
  {
    items.map((n) => (
      <li>
        <time>{n.data.date}</time>
        <div>
          <span set:html={inlineMd(n.data.text)} />
          {!hideProjectLink && n.data.project && (
            <a class="proj" href={url(`/projects/${n.data.project}`)}>
              → project
            </a>
          )}
        </div>
      </li>
    ))
  }
</ul>

<style>
  .news {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    display: grid;
    grid-template-columns: 6.5em 1fr;
    gap: 16px;
    padding: 12px 0;
    border-bottom: 1px dashed var(--border);
  }
  li:last-child {
    border-bottom: none;
  }
  time {
    font-variant-numeric: tabular-nums;
    color: var(--muted);
    font-size: 0.9rem;
    padding-top: 1px;
  }
  .proj {
    margin-left: 8px;
    font-size: 0.82rem;
    white-space: nowrap;
  }
  @media (max-width: 520px) {
    li {
      grid-template-columns: 1fr;
      gap: 2px;
    }
  }
</style>
