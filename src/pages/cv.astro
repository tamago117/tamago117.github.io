---
import Base from '../layouts/Base.astro';
import { profile, url, CV_PDF, inlineMd } from '../lib/site';

// PDF 版（/cv/print）と同じ profile.yaml の cv: を表示する。内容を変えるときは cv: を直す
const cv = profile.cv;
---

<Base title="CV">
  <div class="cv-head">
    <h1 class="page-title">CV</h1>
    <a class="pill download" href={url(`/${CV_PDF}`)} target="_blank" rel="noopener">PDF</a>
  </div>
  <p class="page-lead">
    {profile.name}（{profile.nameJa}）· {profile.email}
    {
      profile.links.map((l) => (
        <>
          {' · '}
          <a href={l.url} target="_blank" rel="noopener">{l.label}{l.handle && l.handle !== l.label ? `: ${l.handle}` : ''}</a>
        </>
      ))
    }
  </p>

  <section class="section">
    <div class="section-head"><h2>Research Interests</h2></div>
    <p>{cv.summary}</p>
    <ul class="interests">
      {
        cv.interests.map((i) => (
          <li>
            <strong>{i.title}:</strong> <Fragment set:html={inlineMd(i.text)} />
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section">
    <div class="section-head"><h2>Education</h2></div>
    <ol class="timeline">
      {
        cv.education.map((e) => (
          <li>
            <span class="when">{e.period}</span>
            <div>
              <div class="what">
                {e.degree}, {e.institution}
              </div>
              <div class="detail">Supervisor: {e.supervisor}</div>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="section">
    <div class="section-head"><h2>Professional Experience</h2></div>
    <ol class="timeline">
      {
        cv.experience.map((e) => (
          <li>
            <span class="when">{e.period}</span>
            <div>
              <div class="what">
                {e.role}, {e.org}
              </div>
              <div class="detail" set:html={inlineMd(e.work)} />
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="section">
    <div class="section-head"><h2>Grants and Fellowships</h2></div>
    <ul class="plain-list">{cv.grants.map((g) => <li set:html={inlineMd(g)} />)}</ul>
  </section>

  <section class="section">
    <div class="section-head"><h2>Awards</h2></div>
    <ol class="timeline">
      {
        cv.awards.map((a) => (
          <li>
            <span class="when">{a.year}</span>
            <div class="what">{a.title}</div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="section">
    <div class="section-head"><h2>Skills</h2></div>
    <dl class="skills">
      {
        cv.skills.map((s) => (
          <>
            <dt>{s.area}</dt>
            <dd>{s.items}</dd>
          </>
        ))
      }
    </dl>
  </section>
</Base>

<style>
  .cv-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }
  .download {
    font-weight: 600;
  }
  .interests,
  .plain-list {
    margin: 8px 0 0;
    padding-left: 1.2em;
  }
  .interests li,
  .plain-list li {
    margin-bottom: 8px;
  }
  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .timeline li {
    display: grid;
    grid-template-columns: 10em 1fr;
    gap: 16px;
    padding: 10px 0;
    border-bottom: 1px dashed var(--border);
  }
  .timeline li:last-child {
    border-bottom: none;
  }
  .when {
    color: var(--muted);
    font-size: 0.9rem;
    font-variant-numeric: tabular-nums;
  }
  .what {
    font-weight: 500;
  }
  .detail {
    color: var(--muted);
    font-size: 0.9rem;
  }
  .skills {
    display: grid;
    grid-template-columns: 12em 1fr;
    gap: 8px 16px;
    margin: 0;
  }
  dt {
    font-weight: 600;
  }
  dd {
    margin: 0;
  }
  @media (max-width: 560px) {
    .timeline li,
    .skills {
      grid-template-columns: 1fr;
      gap: 2px;
    }
    .skills dd {
      margin-bottom: 8px;
    }
  }
</style>
