---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PubItem from '../../components/PubItem.astro';
import NewsList from '../../components/NewsList.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getNews, getProjects, getPublications, getVenues, url } from '../../lib/site';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, prev: projects[i - 1], next: projects[i + 1] },
  }));
}

const { project, prev, next } = Astro.props;
const d = project.data;
const { Content } = await render(project);
const pubs = (await getPublications()).filter((p) => p.data.project === project.id);
const news = (await getNews()).filter((n) => n.data.project === project.id);
const venues = await getVenues(project);
// 専用のプロジェクトページがあるときは、詳細はそちらへ誘導する
const projectPage = d.links.find((l) => /project page/i.test(l.label));
// YouTube の URL（watch?v= / youtu.be / embed）から動画 ID を取り出す
const videos = d.videos
  .map((v) => v.match(/(?:v=|youtu\.be\/|embed\/)([\w-]{11})/)?.[1])
  .filter((id): id is string => Boolean(id));
const gallery = d.gallery.map((g) => ('caption' in g ? g : { src: g, caption: undefined }));
const allProjects = await getProjects();
// related は双方向：自分が書いたもの＋自分を related に書いているもの
const related = allProjects.filter(
  (p) => p.id !== project.id && (d.related.includes(p.id) || p.data.related.includes(project.id)),
);
---

<Base title={d.title} description={d.summary}>
  <a class="back" href={url('/projects')}>← All projects</a>

  <header class="head">
    <div class="meta">
      <a href={url(`/projects?category=${d.category}`)} class="cat"
        >{d.category === 'research' ? 'Research' : 'Development'}</a
      >
      {d.period && <span>{d.period}</span>}
    </div>
    <h1>{d.title}</h1>
    {
      venues.length > 0 && (
        <p class="venues">
          <span class="venues-label">Presented at</span> {venues.join(' · ')}
        </p>
      )
    }
    <p class="summary">{d.summary}</p>
    <div class="row">
      {
        d.tags.map((t) => (
          <a class="tag" href={url(`/projects?tag=${encodeURIComponent(t)}`)}>
            {t}
          </a>
        ))
      }
    </div>
    {d.award && <p><span class="award">🏆 {d.award}</span></p>}
    {
      d.links.length > 0 && (
        <div class="row links">
          {d.links.map((l) => (
            <a class="pill" href={l.url} target="_blank" rel="noopener">
              {l.label} ↗
            </a>
          ))}
        </div>
      )
    }
  </header>

  <figure class="hero">
    <Image src={d.image} alt={d.title} widths={[640, 1080, 1600]} sizes="(max-width: 1080px) 100vw, 1016px" />
  </figure>

  <article class="prose"><Content /></article>

  {
    projectPage && (
      <a class="cta" href={projectPage.url} target="_blank" rel="noopener">
        See the project page for details ↗
      </a>
    )
  }

  {
    videos.map((v) => (
      <div class="video">
        <iframe
          src={`https://www.youtube-nocookie.com/embed/${v}`}
          title={`${d.title} video`}
          loading="lazy"
          allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; fullscreen"
          allowfullscreen
        />
      </div>
    ))
  }

  {
    d.gallery.length > 0 && (
      <div class:list={['gallery', { captioned: gallery.some((g) => g.caption) }]}>
        {gallery.map((g) => (
          <figure>
            <Image
              src={g.src}
              alt={g.caption ?? ''}
              widths={[640, 1080, 1600]}
              sizes="(max-width: 1080px) 100vw, 1016px"
              loading="lazy"
            />
            {g.caption && <figcaption>{g.caption}</figcaption>}
          </figure>
        ))}
      </div>
    )
  }

  {
    pubs.length > 0 && (
      <section class="section">
        <div class="section-head">
          <h2>Publications</h2>
        </div>
        <ul class="plain">
          {pubs.map((p) => (
            <PubItem pub={p} showProject={false} />
          ))}
        </ul>
      </section>
    )
  }

  {
    news.length > 0 && (
      <section class="section">
        <div class="section-head">
          <h2>News</h2>
        </div>
        <NewsList items={news} hideProjectLink />
      </section>
    )
  }

  {
    related.length > 0 && (
      <section class="section">
        <div class="section-head">
          <h2>Related Projects</h2>
        </div>
        <div class="related">
          {related.map((p) => (
            <ProjectCard project={p} />
          ))}
        </div>
      </section>
    )
  }

  <nav class="pager">
    {prev ? <a href={url(`/projects/${prev.id}`)}>← {prev.data.title}</a> : <span />}
    {next ? <a href={url(`/projects/${next.id}`)}>{next.data.title} →</a> : <span />}
  </nav>
</Base>

<style>
  .back {
    font-size: 0.9rem;
    text-decoration: none;
  }
  .head {
    margin: 16px 0 24px;
  }
  .meta {
    display: flex;
    gap: 12px;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .cat {
    font-weight: 600;
    text-decoration: none;
  }
  h1 {
    font-size: clamp(1.6rem, 4vw, 2.3rem);
    margin: 4px 0 8px;
  }
  .venues {
    margin: 0 0 8px;
    font-weight: 600;
    color: var(--accent-text);
    font-size: 0.95rem;
  }
  .venues-label {
    font-weight: 400;
    color: var(--muted);
    margin-right: 4px;
  }
  .summary {
    color: var(--muted);
    margin: 0 0 12px;
    max-width: 70ch;
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .row .tag {
    text-decoration: none;
  }
  .links {
    margin-top: 12px;
  }
  .hero {
    margin: 0 0 28px;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .hero :global(img) {
    width: 100%;
    max-height: 560px;
    object-fit: contain;
  }
  .prose {
    max-width: 72ch;
  }
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 16px;
    margin-top: 24px;
  }
  .cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 8px;
    padding: 10px 20px;
    border-radius: 999px;
    background: var(--accent);
    color: #1d1c1a;
    font-weight: 600;
    text-decoration: none;
  }
  .cta:hover {
    color: #1d1c1a;
    filter: brightness(1.08);
  }
  .video {
    margin-top: 28px;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--border);
    background: #000;
  }
  .video iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }
  .gallery figure {
    margin: 0;
  }
  .gallery :global(img) {
    width: 100%;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: #fff;
  }
  .gallery.captioned {
    grid-template-columns: 1fr;
    gap: 32px;
    margin-top: 36px;
  }
  figcaption {
    font-size: 0.88rem;
    color: var(--muted);
    margin-top: 8px;
    max-width: 80ch;
  }
  .related {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 20px;
  }
  .plain {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .pager {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    margin-top: 64px;
    padding-top: 20px;
    border-top: 1px solid var(--border);
    font-size: 0.9rem;
  }
  .pager a {
    text-decoration: none;
    max-width: 45%;
  }
  .pager a:last-child {
    text-align: right;
  }
</style>
